// KisanVani — PostgreSQL data model
// Money: Decimal(14,2). Quantities in kilograms: Decimal(12,3). Coordinates: Decimal(9,6).
// All timestamps are stored in UTC (timestamptz) and rendered in the user's timezone by the client.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  SHOPKEEPER
  FARMER
  MANDI_OWNER
  DRIVER
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CategoryType {
  VEGETABLE
  FRUIT
  LEAFY_GREEN
  GRAIN
  PULSE
  SPICE
  OTHER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  COMPLETED
}

enum LotType {
  LOOSE
  BAGGED
  CRATED
  BOXED
}

enum LotStatus {
  DRAFT
  AVAILABLE
  PAUSED
  SOLD_OUT
  CLOSED
}

enum InventoryTxnType {
  OPENING
  SALE
  SALE_CANCELLED
  PURCHASE_RECEIPT
  ORDER_RECEIPT
  ADJUSTMENT
  WASTAGE
}

enum PaymentMode {
  CASH
  UPI
  CREDIT
  BANK_TRANSFER
}

enum PaymentPurpose {
  SALE_INVOICE
  CREDIT_COLLECTION
  ORDER
  SUPPLIER_PURCHASE
  TRANSPORT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  ORDERED
  RECEIVED
  CANCELLED
}

enum SupplierType {
  FARMER
  MANDI
  WHOLESALER
  OTHER
}

enum OrderType {
  SHOP_FROM_FARMER
  SHOP_FROM_MANDI
  MANDI_FROM_FARMER
}

enum OrderStatus {
  PLACED
  ACCEPTED
  REJECTED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  RECEIVED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TransportRequestStatus {
  OPEN
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum VehicleType {
  TRACTOR
  MINI_TRUCK
  TEMPO
  PICKUP
  TRUCK
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
  FITNESS
  PERMIT
  POLLUTION
  OTHER
}

enum TripStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id                String     @id @default(uuid())
  name              String
  email             String?    @unique
  mobile            String     @unique
  passwordHash      String
  role              Role
  status            UserStatus @default(ACTIVE)
  statusReason      String?
  preferredLanguage String     @default("en")
  avatarUrl         String?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  farmerProfile       FarmerProfile?
  shopProfile         ShopProfile?
  mandiProfile        MandiProfile?
  driverProfile       DriverProfile?

  harvestListings     HarvestListing[]
  mandiLots           MandiLot[]
  inventoryItems      InventoryItem[]
  customers           Customer[]
  suppliers           Supplier[]
  salesInvoices       SalesInvoice[]         @relation("ShopInvoices")
  purchaseOrders      PurchaseOrder[]
  buyerOrders         Order[]                @relation("OrderBuyer")
  sellerOrders        Order[]                @relation("OrderSeller")
  transportRequests   TransportRequest[]     @relation("TransportRequester")
  driverTrips         Trip[]                 @relation("TripDriver")
  assignedTrips       Trip[]                 @relation("TripAssigner")
  vehicles            Vehicle[]              @relation("VehicleDriver")
  paymentsMade        Payment[]              @relation("PaymentPayer")
  paymentsReceived    Payment[]              @relation("PaymentPayee")
  paymentsRecorded    Payment[]              @relation("PaymentRecorder")
  settlementsPayable  Settlement[]           @relation("SettlementPayer")
  settlementsReceived Settlement[]           @relation("SettlementPayee")
  notifications       Notification[]
  inventoryTxns       InventoryTransaction[]
  orderHistory        OrderStatusHistory[]
  tripEvents          TripEvent[]
  deliveryProofs      DeliveryProof[]
  settingsUpdated     ApplicationSetting[]
  chatParticipations  ChatParticipant[]
  chatMessages        ChatMessage[]          @relation("ChatSender")
  callsMade           Call[]                 @relation("CallCaller")
  callsReceived       Call[]                 @relation("CallReceiver")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  otpHash   String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Profiles ─────────────────────────────

model Address {
  id        String   @id @default(uuid())
  line1     String?
  village   String?
  city      String?
  district  String?
  state     String?
  pincode   String?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmerProfile FarmerProfile?
  shopProfile   ShopProfile?
  mandiProfile  MandiProfile?
  driverProfile DriverProfile?

  @@index([district])
  @@map("addresses")
}

model FarmerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  farmName     String?
  landAcres    Decimal? @db.Decimal(8, 2)
  primaryCrops String[]
  upiId        String?
  bankAccount  String?
  ifsc         String?
  addressId    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id])

  @@map("farmer_profiles")
}

model ShopProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  shopName      String
  shopCode      String   @unique
  gstin         String?
  upiId         String?
  receiptFooter String?
  addressId     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id])

  @@map("shop_profiles")
}

model MandiProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  mandiName         String
  marketYardName    String?
  licenseNumber     String?  @unique
  commissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  upiId             String?
  addressId         String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id])

  @@map("mandi_profiles")
}

model DriverProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  licenseNumber String    @unique
  licenseExpiry DateTime?
  experienceYrs Int?
  isAvailable   Boolean   @default(true)
  addressId     String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id])

  @@map("driver_profiles")
}

// ───────────────────────────── Vehicles ─────────────────────────────

model Vehicle {
  id                 String             @id @default(uuid())
  driverId           String
  registrationNumber String             @unique
  type               VehicleType
  make               String?
  model              String?
  capacityKg         Decimal            @db.Decimal(12, 3)
  ownerName          String
  ownerMobile        String?
  insurancePolicyNo  String?
  insuranceExpiry    DateTime?
  fitnessExpiry      DateTime?
  permitNumber       String?
  permitExpiry       DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verificationNote   String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  driver    User              @relation("VehicleDriver", fields: [driverId], references: [id])
  documents VehicleDocument[]
  trips     Trip[]

  @@index([driverId])
  @@index([verificationStatus])
  @@map("vehicles")
}

model VehicleDocument {
  id                 String              @id @default(uuid())
  vehicleId          String
  type               VehicleDocumentType
  documentNumber     String?
  fileUrl            String
  expiryDate         DateTime?
  verificationStatus VerificationStatus  @default(PENDING)
  createdAt          DateTime            @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_documents")
}

// ───────────────────────────── Catalog ─────────────────────────────

model ProductCategory {
  id        String       @id @default(uuid())
  name      String       @unique
  slug      String       @unique
  type      CategoryType
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products        Product[]
  harvestListings HarvestListing[]
  mandiLots       MandiLot[]

  @@map("product_categories")
}

model Product {
  id         String   @id @default(uuid())
  name       String   @unique
  localName  String?
  categoryId String
  emoji      String?
  imageUrl   String?
  unit       String   @default("kg")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category        ProductCategory     @relation(fields: [categoryId], references: [id])
  inventoryItems  InventoryItem[]
  harvestListings HarvestListing[]
  mandiLots       MandiLot[]
  invoiceItems    SalesInvoiceItem[]
  orderItems      OrderItem[]
  purchaseItems   PurchaseOrderItem[]

  @@index([categoryId])
  @@map("products")
}

// ───────────────────────────── Supply listings ─────────────────────────────

model HarvestListing {
  id                  String        @id @default(uuid())
  farmerId            String
  productId           String
  categoryId          String
  cropName            String
  variety             String?
  grade               String?
  description         String?
  harvestAt           DateTime
  totalQuantityKg     Decimal       @db.Decimal(12, 3)
  availableQuantityKg Decimal       @db.Decimal(12, 3)
  pricePerKg          Decimal       @db.Decimal(14, 2)
  minOrderKg          Decimal       @db.Decimal(12, 3)
  village             String?
  district            String?
  latitude            Decimal?      @db.Decimal(9, 6)
  longitude           Decimal?      @db.Decimal(9, 6)
  images              String[]
  freshnessNotes      String?
  status              ListingStatus @default(DRAFT)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  farmer     User            @relation(fields: [farmerId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([status, categoryId])
  @@index([farmerId])
  @@index([district])
  @@map("harvest_listings")
}

model MandiLot {
  id                String    @id @default(uuid())
  lotCode           String    @unique
  mandiOwnerId      String
  productId         String
  categoryId        String
  commodityName     String
  variety           String?
  grade             String?
  lotType           LotType   @default(LOOSE)
  unitSizeKg        Decimal?  @db.Decimal(10, 3)
  totalWeightKg     Decimal   @db.Decimal(12, 3)
  availableWeightKg Decimal   @db.Decimal(12, 3)
  pricePerKg        Decimal   @db.Decimal(14, 2)
  minOrderKg        Decimal   @db.Decimal(12, 3)
  marketYardName    String
  location          String?
  district          String?
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  qualityNotes      String?
  loadingInfo       String?
  images            String[]
  status            LotStatus @default(DRAFT)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  mandiOwner User            @relation(fields: [mandiOwnerId], references: [id])
  product    Product         @relation(fields: [productId], references: [id])
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([status, categoryId])
  @@index([mandiOwnerId])
  @@map("mandi_lots")
}

// ───────────────────────────── Retail inventory & POS ─────────────────────────────

model InventoryItem {
  id                  String   @id @default(uuid())
  shopId              String
  productId           String
  quantityKg          Decimal  @default(0) @db.Decimal(12, 3)
  sellingPricePerKg   Decimal  @db.Decimal(14, 2)
  costPricePerKg      Decimal? @db.Decimal(14, 2)
  lowStockThresholdKg Decimal  @default(5) @db.Decimal(12, 3)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shop         User                   @relation(fields: [shopId], references: [id])
  product      Product                @relation(fields: [productId], references: [id])
  transactions InventoryTransaction[]
  invoiceItems SalesInvoiceItem[]

  @@unique([shopId, productId])
  @@index([shopId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id               String           @id @default(uuid())
  inventoryItemId  String
  type             InventoryTxnType
  quantityChangeKg Decimal          @db.Decimal(12, 3)
  balanceAfterKg   Decimal          @db.Decimal(12, 3)
  referenceType    String?
  referenceId      String?
  note             String?
  createdById      String?
  createdAt        DateTime         @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation(fields: [createdById], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model Customer {
  id            String   @id @default(uuid())
  shopId        String
  name          String
  mobile        String
  address       String?
  creditBalance Decimal  @default(0) @db.Decimal(14, 2)
  creditLimit   Decimal  @default(5000) @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop     User           @relation(fields: [shopId], references: [id])
  invoices SalesInvoice[]
  payments Payment[]

  @@unique([shopId, mobile])
  @@index([shopId, name])
  @@map("customers")
}

model Supplier {
  id           String       @id @default(uuid())
  shopId       String
  name         String
  mobile       String?
  type         SupplierType @default(OTHER)
  linkedUserId String?
  address      String?
  gstin        String?
  notes        String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  shop           User            @relation(fields: [shopId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([shopId, name])
  @@map("suppliers")
}

model SalesInvoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  shopId         String
  customerId     String?
  customerName   String?
  customerMobile String?
  subtotal       Decimal       @db.Decimal(14, 2)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  paymentMode    PaymentMode
  amountPaid     Decimal       @db.Decimal(14, 2)
  creditAmount   Decimal       @default(0) @db.Decimal(14, 2)
  status         InvoiceStatus @default(COMPLETED)
  idempotencyKey String
  cancelReason   String?
  cancelledAt    DateTime?
  printCount     Int           @default(0)
  createdAt      DateTime      @default(now())

  shop     User               @relation("ShopInvoices", fields: [shopId], references: [id])
  customer Customer?          @relation(fields: [customerId], references: [id])
  items    SalesInvoiceItem[]
  payments Payment[]

  @@unique([shopId, idempotencyKey])
  @@index([shopId, createdAt])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id              String  @id @default(uuid())
  invoiceId       String
  inventoryItemId String
  productId       String
  productName     String
  quantityKg      Decimal @db.Decimal(12, 3)
  unitPrice       Decimal @db.Decimal(14, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  invoice       SalesInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("sales_invoice_items")
}

// Off-platform purchases recorded by a shop from its own suppliers.
model PurchaseOrder {
  id         String              @id @default(uuid())
  poNumber   String              @unique
  shopId     String
  supplierId String
  status     PurchaseOrderStatus @default(ORDERED)
  total      Decimal             @db.Decimal(14, 2)
  amountPaid Decimal             @default(0) @db.Decimal(14, 2)
  notes      String?
  orderedAt  DateTime            @default(now())
  receivedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  shop     User                @relation(fields: [shopId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  payments Payment[]

  @@index([shopId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                 String   @id @default(uuid())
  purchaseOrderId    String
  productId          String
  quantityKg         Decimal  @db.Decimal(12, 3)
  receivedQuantityKg Decimal? @db.Decimal(12, 3)
  unitCost           Decimal  @db.Decimal(14, 2)
  lineTotal          Decimal  @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ───────────────────────────── Platform orders (procurement & wholesale) ─────────────────────────────
// One unified model covers shop→farmer purchases, shop→mandi wholesale orders and mandi→farmer procurement.

model Order {
  id                 String             @id @default(uuid())
  orderNumber        String             @unique
  type               OrderType
  buyerId            String
  sellerId           String
  status             OrderStatus        @default(PLACED)
  subtotal           Decimal            @db.Decimal(14, 2)
  total              Decimal            @db.Decimal(14, 2)
  amountPaid         Decimal            @default(0) @db.Decimal(14, 2)
  paymentStatus      OrderPaymentStatus @default(UNPAID)
  deliveryAddress    String?
  expectedDeliveryAt DateTime?
  notes              String?
  rejectionReason    String?
  cancelReason       String?
  idempotencyKey     String
  receivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  buyer             User                 @relation("OrderBuyer", fields: [buyerId], references: [id])
  seller            User                 @relation("OrderSeller", fields: [sellerId], references: [id])
  items             OrderItem[]
  history           OrderStatusHistory[]
  payments          Payment[]
  settlement        Settlement?
  transportRequests TransportRequest[]
  trips             Trip[]

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid())
  orderId             String
  harvestListingId    String?
  mandiLotId          String?
  productId           String
  itemName            String
  quantityKg          Decimal  @db.Decimal(12, 3)
  unitPrice           Decimal  @db.Decimal(14, 2)
  lineTotal           Decimal  @db.Decimal(14, 2)
  deliveredQuantityKg Decimal? @db.Decimal(12, 3)
  receivedQuantityKg  Decimal? @db.Decimal(12, 3)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  harvestListing HarvestListing? @relation(fields: [harvestListingId], references: [id])
  mandiLot       MandiLot?       @relation(fields: [mandiLotId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([harvestListingId])
  @@index([mandiLotId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  note        String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ───────────────────────────── Transport ─────────────────────────────

model TransportRequest {
  id                   String                 @id @default(uuid())
  requestNumber        String                 @unique
  requesterId          String
  orderId              String?
  commodity            String
  expectedQuantityKg   Decimal                @db.Decimal(12, 3)
  pickupAddress        String
  pickupLat            Decimal?               @db.Decimal(9, 6)
  pickupLng            Decimal?               @db.Decimal(9, 6)
  pickupContactName    String
  pickupContactPhone   String
  dropAddress          String
  dropLat              Decimal?               @db.Decimal(9, 6)
  dropLng              Decimal?               @db.Decimal(9, 6)
  dropContactName      String?
  dropContactPhone     String?
  preferredVehicleType VehicleType?
  preferredPickupAt    DateTime?
  offeredCharge        Decimal?               @db.Decimal(14, 2)
  status               TransportRequestStatus @default(OPEN)
  notes                String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  requester User   @relation("TransportRequester", fields: [requesterId], references: [id])
  order     Order? @relation(fields: [orderId], references: [id])
  trips     Trip[]

  @@index([status])
  @@index([requesterId])
  @@index([orderId])
  @@map("transport_requests")
}

model Trip {
  id                  String     @id @default(uuid())
  tripNumber          String     @unique
  transportRequestId  String?
  orderId             String?
  driverId            String
  vehicleId           String
  assignedById        String?
  commodity           String
  pickupAddress       String
  pickupLat           Decimal?   @db.Decimal(9, 6)
  pickupLng           Decimal?   @db.Decimal(9, 6)
  pickupContactName   String
  pickupContactPhone  String
  dropAddress         String
  dropLat             Decimal?   @db.Decimal(9, 6)
  dropLng             Decimal?   @db.Decimal(9, 6)
  dropContactName     String?
  dropContactPhone    String?
  expectedQuantityKg  Decimal    @db.Decimal(12, 3)
  loadedQuantityKg    Decimal?   @db.Decimal(12, 3)
  deliveredQuantityKg Decimal?   @db.Decimal(12, 3)
  transportCharge     Decimal    @default(0) @db.Decimal(14, 2)
  amountPaid          Decimal    @default(0) @db.Decimal(14, 2)
  status              TripStatus @default(ASSIGNED)
  acceptedAt          DateTime?
  pickedUpAt          DateTime?
  startedAt           DateTime?
  estimatedArrivalAt  DateTime?
  deliveredAt         DateTime?
  statusReason        String?
  trackingActive      Boolean    @default(false)
  lastLat             Decimal?   @db.Decimal(9, 6)
  lastLng             Decimal?   @db.Decimal(9, 6)
  lastLocationAt      DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  transportRequest TransportRequest? @relation(fields: [transportRequestId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  driver           User              @relation("TripDriver", fields: [driverId], references: [id])
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  assignedBy       User?             @relation("TripAssigner", fields: [assignedById], references: [id])
  locations        TripLocation[]
  events           TripEvent[]
  deliveryProofs   DeliveryProof[]
  payments         Payment[]

  @@index([driverId, status])
  @@index([orderId])
  @@index([status])
  @@map("trips")
}

model TripEvent {
  id         String      @id @default(uuid())
  tripId     String
  fromStatus TripStatus?
  toStatus   TripStatus
  actorId    String?
  note       String?
  createdAt  DateTime    @default(now())

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([tripId, createdAt])
  @@map("trip_events")
}

model TripLocation {
  id         String   @id @default(uuid())
  tripId     String
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  accuracyM  Decimal? @db.Decimal(10, 2)
  speedMps   Decimal? @db.Decimal(8, 2)
  heading    Decimal? @db.Decimal(6, 2)
  recordedAt DateTime
  createdAt  DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@map("trip_locations")
}

model DeliveryProof {
  id                  String   @id @default(uuid())
  tripId              String
  fileUrl             String?
  receiverName        String
  receiverMobile      String?
  deliveredQuantityKg Decimal  @db.Decimal(12, 3)
  notes               String?
  uploadedById        String
  createdAt           DateTime @default(now())

  trip       Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([tripId])
  @@map("delivery_proofs")
}

// ───────────────────────────── Money ─────────────────────────────

model Payment {
  id              String         @id @default(uuid())
  paymentNumber   String         @unique
  purpose         PaymentPurpose
  amount          Decimal        @db.Decimal(14, 2)
  mode            PaymentMode
  status          PaymentStatus  @default(COMPLETED)
  reference       String?
  notes           String?
  payerId         String?
  payeeId         String?
  recordedById    String
  invoiceId       String?
  customerId      String?
  orderId         String?
  purchaseOrderId String?
  tripId          String?
  createdAt       DateTime       @default(now())

  payer         User?          @relation("PaymentPayer", fields: [payerId], references: [id])
  payee         User?          @relation("PaymentPayee", fields: [payeeId], references: [id])
  recordedBy    User           @relation("PaymentRecorder", fields: [recordedById], references: [id])
  invoice       SalesInvoice?  @relation(fields: [invoiceId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  trip          Trip?          @relation(fields: [tripId], references: [id])

  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
  @@index([orderId])
  @@index([purpose, createdAt])
  @@map("payments")
}

model Settlement {
  id               String           @id @default(uuid())
  settlementNumber String           @unique
  orderId          String           @unique
  payerId          String
  payeeId          String
  grossAmount      Decimal          @db.Decimal(14, 2)
  commissionAmount Decimal          @default(0) @db.Decimal(14, 2)
  netAmount        Decimal          @db.Decimal(14, 2)
  paidAmount       Decimal          @default(0) @db.Decimal(14, 2)
  status           SettlementStatus @default(PENDING)
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  payer User  @relation("SettlementPayer", fields: [payerId], references: [id])
  payee User  @relation("SettlementPayee", fields: [payeeId], references: [id])

  @@index([payeeId, status])
  @@index([payerId, status])
  @@map("settlements")
}

// ───────────────────────────── Platform ─────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ApplicationSetting {
  key         String   @id
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("application_settings")
}

// Atomic counters for human-readable document numbers (invoices, orders, trips…)
model DocumentCounter {
  key   String @id
  value Int    @default(0)

  @@map("document_counters")
}

// ───────────────────────────── Chat ─────────────────────────────
// One-to-one conversations between users whose roles may talk to each other (see chat.permissions.js).

model ChatConversation {
  id            String    @id @default(uuid())
  /// The two user ids, sorted and joined with ":" — one conversation per pair of users.
  pairKey       String    @unique
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]
  calls        Call[]

  @@index([lastMessageAt])
  @@map("chat_conversations")
}

/// Per-user state of a conversation: "clear chat" and "delete chat" only affect this user.
model ChatParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  /// Messages created at or before this moment are hidden for this user.
  clearedAt      DateTime?
  /// Conversation hidden from this user's list until a newer message arrives.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  editedAt       DateTime?
  /// Sent = created; delivered = reached the other user's device; read = they opened the chat.
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt])
  @@index([senderId])
  @@map("chat_messages")
}

// ───────────────────────────── Voice & video calls ─────────────────────────────
// In-app WebRTC calls between two chat partners. Socket.IO only carries the signalling;
// audio and video travel directly between the browsers (or through the TURN server).

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  INITIATED // created, the receiver's devices have not been reached yet
  RINGING // ringing on at least one of the receiver's devices
  ACCEPTED // answered, in progress
  REJECTED // declined by the receiver
  MISSED // not answered in time, or the receiver was offline
  BUSY // the receiver was already in another call
  CANCELLED // the caller hung up before it was answered
  ENDED // answered and finished
}

model Call {
  id             String     @id @default(uuid())
  conversationId String
  callerId       String
  receiverId     String
  callType       CallType
  status         CallStatus @default(INITIATED)
  /// HANGUP, DISCONNECTED, FAILED, TIMEOUT … — why the call finished.
  endReason      String?
  startedAt      DateTime   @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  /// Seconds between answering and hanging up (0 when never answered).
  duration       Int        @default(0)
  createdAt      DateTime   @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User             @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  receiver     User             @relation("CallReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([callerId, createdAt])
  @@index([receiverId, createdAt])
  @@index([status])
  @@map("calls")
}
