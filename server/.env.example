# ─── Core ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kisanvani?schema=public"
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
CLIENT_URL=http://localhost:5173

# ─── Auth tuning (optional) ─────────────────────────────
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Set to true behind HTTPS so the refresh cookie gets the Secure flag
COOKIE_SECURE=false
# lax works when client and API share a site (e.g. app.example.com + api.example.com).
# Use none (requires HTTPS) only if they are on different sites.
COOKIE_SAME_SITE=lax

# ─── Email (optional — password reset mails) ────────────
# When SMTP_HOST is empty, reset links/OTPs are written to the server log in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KisanVani <no-reply@kisanvani.local>"

# ─── Uploads ────────────────────────────────────────────
# local | s3   (s3 works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces…)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
PUBLIC_SERVER_URL=http://localhost:5000
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─── Tracking ───────────────────────────────────────────
TRACKING_MIN_INTERVAL_SEC=5
TRACKING_STALE_AFTER_SEC=120

# ─── Logging ────────────────────────────────────────────
LOG_LEVEL=info
LOG_TO_FILE=true
